<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Authentication Test Suite" verbose="2" parallel="tests" thread-count="4">

    <test name="Basic Authentication Tests">
        <classes>
            <class name="com.sk.tests.AuthenticationTests">
                <methods>
                    <include name="testValidLogin" />
                    <include name="testInvalidUsername" />
                    <include name="testInvalidPassword" />
                    <include name="testEmptyUsername" />
                    <include name="testEmptyPassword" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Security Tests">
        <classes>
            <class name="com.sk.tests.AuthenticationTests">
                <methods>
                    <include name="testSQLInjectionAttempt" />
                    <include name="testCaseSensitivity" />
                    <include name="testSpecialCharactersInPassword" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="User Experience Tests">
        <classes>
            <class name="com.sk.tests.AuthenticationTests">
                <methods>
                    <include name="testLogout" />
                    <include name="testRememberMeFunctionality" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Data-Driven Authentication Tests">
        <classes>
            <class name="com.sk.tests.AuthenticationTests">
                <methods>
                    <include name="testLoginWithMultipleCredentials" />
                </methods>
            </class>
        </classes>
    </test>

    <!-- "Complete" full-class run removed — put it in its own suite file
         if you want a full regression pass, e.g. full-regression.xml -->

</suite>