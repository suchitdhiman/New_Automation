<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="instances" - one thread per object produced by the @Factory.
  ParallelInstancesTest's factory builds three instances (amazon, bbc,
  facebook), so three threads run, and each instance's methods stay in order
  on its own thread - which is what lets dependsOnMethods still work.
-->
<suite name="ParallelInstancesSuite" parallel="instances" thread-count="3" verbose="1">

  <parameter name="browser" value="chrome"/>
  <parameter name="url" value="amazon"/>

  <test name="InstanceLevelParallel">
    <classes>
      <class name="testngpack.tests.ParallelInstancesTest"/>
    </classes>
  </test>

</suite>
