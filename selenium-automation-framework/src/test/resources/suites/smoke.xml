<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite" parallel="methods" thread-count="2" verbose="1">

    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="com.sk.automation.listeners.TestListener"/>
        <listener class-name="com.sk.automation.listeners.RetryTransformer"/>
    </listeners>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.sk.automation.tests"/>
        </packages>
    </test>
</suite>
